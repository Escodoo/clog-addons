<odoo>

    <record id="document_form" model="ir.ui.view">
        <field
            name="name"
        >l10n_br_fiscal.document.form (in clog_l10n_br_mdfe_custom)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <field name="mdfe30_cInt" position="before">
                <field
                    name="mdfe_veiculo"
                    attrs="{'required': [('mdfe_modal', '=', '1'), ('document_type', '=', '58')]}"
                />
            </field>
            <field name="mdfe_final_state_id" position="after">
                <field
                    name="mdfe_destino_prestacao"
                    attrs="{'invisible': [('document_type', '!=', '58')]}"
                />
            </field>
            <field name="mdfe30_prop" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

</odoo>
