    <record id="view_purchase_order_form_inherit_maintenance_type" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.maintenance.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
