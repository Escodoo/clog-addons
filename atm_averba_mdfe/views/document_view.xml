<odoo>

    <record id="document_form_atm_averba" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.form (in atm_averba_cte)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="after">
                <widget
                    name="web_ribbon"
                    title="Endorsed"
                    attrs="{'invisible': [('atm_averba_endorsement_state', '!=', 'endorsed')]}"
                />
            </div>
            <notebook position="inside">
                <page
                    string="ATM MDF-e"
                    attrs="{'invisible': [('document_type', 'not in', ['58'])]}"
                >
                    <group string="ATM Averba MDF-e">
                        <group>
                            <field
                                name="atm_averba_endorsement_state"
                                string="Endorsement State"
                                widget="badge"
                                decoration-success="atm_averba_endorsement_state == 'endorsed'"
                                decoration-danger="atm_averba_endorsement_state == 'error'"
                            />
                            <field
                                name="atm_averba_date_send"
                                string="Date Send"
                                readonly="1"
                            />
                        </group>
                    </group>
                    <field name="atm_averba_event_ids" nolabel="1" readonly="1">
                            <tree>
                                <field name="company_id" />
                                <field name="document_id" />
                                <field name="date" />
                                <field name="endorsement_message" />
                                <field
                                name="endorsement_state"
                                widget="badge"
                                decoration-success="endorsement_state == 'endorsed'"
                                decoration-danger="endorsement_state == 'error'"
                            />
                            </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="atm_mdfe_close_action" model="ir.actions.server">
        <field name="name">Close MDF-e (ATM)</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="l10n_br_fiscal.model_l10n_br_fiscal_document" />
        <field
            name="binding_model_id"
            ref="l10n_br_fiscal.model_l10n_br_fiscal_document"
        />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.mdfe_close()</field>
    </record>

    <record id="atm_mdfe_cancel_action" model="ir.actions.server">
        <field name="name">Cancel MDF-e (ATM)</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="l10n_br_fiscal.model_l10n_br_fiscal_document" />
        <field
            name="binding_model_id"
            ref="l10n_br_fiscal.model_l10n_br_fiscal_document"
        />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.mdfe_cancel()</field>
    </record>

</odoo>
